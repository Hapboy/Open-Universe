# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Higgsfield AI — format: apikey:apisecret (from platform.higgsfield.ai)
# Server-only (no NEXT_PUBLIC_ prefix): read only by app/api/higgsfield/*/route.ts.
HIGGSFIELD_KEY=

# Pinterest — Bearer token (from developers.pinterest.com)
# Server-only: read only by app/api/pinterest/*/route.ts.
PINTEREST_TOKEN=

# Mapbox — access token, used for satellite tile imagery on the World Map globe (from account.mapbox.com)
NEXT_PUBLIC_MAPBOX_TOKEN=

# apps/api backend URL (Railway) — see docs/backend-bootstrap.md
NEXT_PUBLIC_API_URL=
# Same public R2 bucket URL as apps/api/.env.local's R2_PUBLIC_URL — non-sensitive
NEXT_PUBLIC_R2_PUBLIC_URL=
