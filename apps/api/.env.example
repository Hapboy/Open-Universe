# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Railway Postgres — from the Postgres service's Variables tab, DATABASE_URL.
DATABASE_URL=

# Railway Redis — from the Redis service's Variables tab, REDIS_URL.
REDIS_URL=

# Cloudflare R2 (S3-compatible) — media storage. Dashboard: R2 Object
# Storage > your bucket > Settings (name/public URL); Manage R2 API Tokens
# (access key/secret); Account ID is on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Optional, comma-separated. Defaults to localhost:4174 + the prod Vercel
# domain (see main.ts) if unset — only set this to override/extend that list
# (e.g. a Vercel preview-branch URL).
CORS_ORIGINS=

# Google Gemini / Imagen — API key (from aistudio.google.com). Optional: AI
# Gateway's Gemini routes soft-fail with 501 if unset, same as the frontend
# routes they replace.
GEMINI_KEY=

# Auth (see docs/DECISIONS.md's "Auth: JWT bearer token" entry) — required,
# fails fast at boot if unset (see config/env.validation.ts). Generate a
# real secret with e.g. `openssl rand -base64 48`.
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Pinterest OAuth (developers.pinterest.com app dashboard). Optional: the
# /pinterest/* routes soft-fail with 501 if unset, same posture as GEMINI_KEY.
# PINTEREST_REDIRECT_URI must exactly match a redirect URI registered in the
# Pinterest app's settings, pointed at this API's own callback route, e.g.
# https://<this-api>/pinterest/oauth/callback.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=

# Frontend base URL the Pinterest OAuth callback bounces the popup back to.
# Defaults to http://localhost:4174 if unset.
APP_URL=
