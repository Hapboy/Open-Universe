{
    "name": "open-universe",
    "type": "module",
    "private": true,
    "workspaces": [
        "apps/web",
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev -w apps/web",
        "build": "npm run build -w apps/web",
        "start": "npm run start -w apps/web",
        "typecheck": "npm run typecheck -w apps/web",
        "lint": "eslint .",
        "format": "prettier --write .",
        "prepare": "husky || true",
        "knip": "knip",
        "clean": "rm -rf node_modules dist .next"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.1",
        "eslint": "^10.6.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "eslint-plugin-unused-imports": "^4.4.1",
        "husky": "^9.1.7",
        "knip": "^6.25.0",
        "lint-staged": "^17.0.8",
        "prettier": "^3.9.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0"
    }
}
