# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Higgsfield AI — format: apikey:apisecret (from platform.higgsfield.ai)
NEXT_PUBLIC_HIGGSFIELD_KEY=

# Pinterest — Bearer token (from developers.pinterest.com)
NEXT_PUBLIC_PINTEREST_TOKEN=

# Google Gemini / Imagen — API key (from aistudio.google.com)
NEXT_PUBLIC_GEMINI_KEY=

# Mapbox — access token, used for satellite tile imagery on the World Map globe (from account.mapbox.com)
NEXT_PUBLIC_MAPBOX_TOKEN=
